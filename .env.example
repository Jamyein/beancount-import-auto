# ============================================================
# Beancount Import Auto - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!
# ============================================================

# ------------------------------------------------------------
# DeepSeek/OpenAI API Configuration (Required)
# ------------------------------------------------------------
# Get your API key from: https://platform.deepseek.com/
OPENAI_API_KEY=your_api_key_here

# API Base URL (default: https://api.deepseek.com)
OPENAI_API_BASE=https://api.deepseek.com

# Model name (default: deepseek-chat)
OPENAI_MODEL=deepseek-chat

# ------------------------------------------------------------
# Logging Configuration (Optional)
# ------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log directory
LOG_DIR=logs

# ------------------------------------------------------------
# Import Configuration (Optional)
# ------------------------------------------------------------
# Main beancount file
MAIN_BEAN_FILE=main.beancount

# Monthly data directory
MONTHLY_DIR=data

# Bills input directory
BILLS_DIR=bills

# Archived directory
ARCHIVED_DIR=archived

# ------------------------------------------------------------
# Security Configuration (Optional)
# ------------------------------------------------------------
# Maximum file size in MB
MAX_FILE_SIZE=10

# Minimum date (format: YYYY-MM-DD)
MIN_DATE=2000-01-01

# Maximum amount
MAX_AMOUNT=100000000
